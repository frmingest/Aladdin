# Copy to .env.local for a local override, or pass as --build-arg values to
# frontend/Dockerfile. Both are compile-time (Vite bakes them into the
# built JS, they don't exist at runtime) — see src/lib/api.ts. Leave both
# unset for local dev: Vite's dev-server proxy (vite.config.ts) makes /api
# and /health same-origin, and the backend's auth is disabled by default
# (see backend/.env.example — APP_AUTH_TOKEN unset).

# The backend's own origin, no /api suffix and no trailing slash — only
# needed when frontend and backend are separate origins/services (e.g. two
# Railway apps).
VITE_API_BASE_URL=

# Must match the backend's APP_AUTH_TOKEN exactly (2026-09-27, see
# backend/app/security.py). Sent as the X-API-Key header on every request
# (src/lib/api.ts). Note this ends up readable in the built JS bundle by
# anyone who opens dev tools — it's a minimal gate against stray/automated
# requests hitting a public backend URL, not real access control. Leave
# both this and the backend's APP_AUTH_TOKEN unset to keep today's
# no-auth behavior.
VITE_API_KEY=
