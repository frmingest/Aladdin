# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
# Any other venv variant a session creates (e.g. .venv-linux, for running
# pytest from a Linux device-bridge shell against a Windows checkout) —
# 2026-09-27: one of these almost got committed wholesale (thousands of
# files, some Windows git can't even process) because it didn't match the
# two patterns above.
.venv-*/
*-venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite3

# --- Node / frontend ---
node_modules/
dist/
.vite/
vite.config.ts.timestamp-*.mjs
.env
.env.local

# --- Secrets & config ---
*.pem
*.key
.env*
!.env.example

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- App data (never commit real portfolio/source docs) ---
storage/
uploads/
*.pdf
*.pptx
*.xlsx
!docs/**/*.pdf
*.tsbuildinfo

# --- Playwright smoke test output ---
frontend/playwright-report/
frontend/test-results/
