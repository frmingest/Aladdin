# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker Postgres (see docker/docker-compose.yml):
DATABASE_URL=postgresql://aladdin:aladdin@localhost:5432/aladdin
# Or point at Supabase instead. Project Settings > Database > Connection
# string in the Supabase dashboard offers three variants:
#   - Direct connection (db.<project-ref>.supabase.co:5432) — IPv6-only on
#     most projects unless you've bought the IPv4 add-on. If your network
#     doesn't have IPv6, this fails DNS resolution outright ("No such host
#     is known"), not just connection.
#   - Session pooler (aws-0-<region>.pooler.supabase.com:5432, username
#     postgres.<project-ref>) — IPv4-compatible, behaves like a normal
#     Postgres session (works fine with Alembic). Use this one if the
#     direct connection doesn't resolve.
#   - Transaction pooler (same host, port 6543) — pgbouncer transaction
#     mode; avoid for migrations, it can break prepared statements.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=aladdin-documents
OBJECT_STORAGE_LOCAL_PATH=./storage
# Only used when OBJECT_STORAGE_PROVIDER is r2 or supabase — both expose an
# S3-compatible API (see docs/decisions/0010), so the same four settings
# configure either:
#   R2:       OBJECT_STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#             OBJECT_STORAGE_REGION=auto
#   Supabase: OBJECT_STORAGE_ENDPOINT_URL=https://<project_ref>.supabase.co/storage/v1/s3
#             OBJECT_STORAGE_REGION=<project region, e.g. eu-west-1>
# Access key/secret: R2 = an API token's Access Key ID/Secret Access Key
# (Cloudflare dashboard > R2 > Manage API Tokens); Supabase = Storage's S3
# access keys (Project Settings > Storage > S3 Connection).
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

MAX_UPLOAD_SIZE_MB=25

# --- Deployment & production hardening (§26, see docs/decisions/0010) ---
# Empty disables both — the default, for local dev/tests. Set both before
# putting the backend behind a public URL:
#   APP_AUTH_TOKEN: a shared secret; every request to a domain endpoint
#     (not /health) must send it back as the X-API-Key header.
#   CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call
#     this API cross-origin (e.g. the deployed frontend's own URL) — only
#     needed once frontend and backend are separate origins/services.
APP_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=

# Google AI Studio's free tier (see
# docs/decisions/0005-phase3-google-ai-studio-llm-provider.md) — get a key at
# https://aistudio.google.com/apikey. Analysis runs (POST
# /analysis/snapshots/{id}/runs) fail immediately with an explicit error
# until this is set.
LLM_PROVIDER=google_ai_studio
GOOGLE_AI_STUDIO_API_KEY=
LLM_MODEL_NAME=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_EXCERPT_CHAR_BUDGET=12000

# --- LLM usage ledger & free-tier rate-limit estimation (see
# docs/decisions/0013-llm-usage-ledger-and-rate-limit-estimation.md) ---
# Not fetched from Google (no public API for a free-tier AI Studio key's
# quota) — keep these in sync by hand with whatever
# aistudio.google.com/usage shows for LLM_MODEL_NAME's tier. Defaults below
# match gemini-3.6-flash's free tier as observed 2026-09-14.
LLM_RATE_LIMIT_RPM=5
LLM_RATE_LIMIT_TPM=250000
LLM_RATE_LIMIT_RPD=20
# Calibration baseline for the "how many analyses can we run" estimate,
# seeded from the Vår Energi run (3 documents/280 pages, single blind-pass
# call) — overridden by real ledger history the moment any exists.
LLM_BASELINE_INPUT_TOKENS=5870
LLM_BASELINE_OUTPUT_TOKENS=1484

# --- Fallback LLM provider (see claude/llm-provider-alternatives-2026-09-17.md
# project doc) — used only once the Gemini budget above is exhausted mid-run,
# so a holding gets a real analysis instead of being skipped outright.
# "none" (default) keeps the original skip-on-exhaustion behavior; set to
# "mistral" and fill in MISTRAL_API_KEY below to enable it. Get a free key at
# https://console.mistral.ai/api-keys.
LLM_FALLBACK_PROVIDER=none
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest
# Assumed conservative default, not vendor-confirmed — check
# https://console.mistral.ai/ for your account's actual limit and adjust.
MISTRAL_RATE_LIMIT_RPM=30

# yfinance needs no API key (Yahoo Finance, unofficial) — see
# docs/decisions/0004-phase2-market-data-and-financial-metrics.md.
MARKET_DATA_PROVIDER=yfinance

# --- External research (§26 Phase 4 — see
# docs/decisions/0007-phase4-external-research.md) ---
# Central-bank/macro numeric data: FRED (primary) + Norges Bank (NOK-specific).
# Get a free FRED key at https://fred.stlouisfed.org/docs/api/api_key.html —
# Norges Bank's API needs no key. Macro refresh fails immediately with an
# explicit error until FRED_API_KEY is set.
MACRO_DATA_PROVIDER=fred_norges_bank
FRED_API_KEY=
ACTIVE_MACRO_SERIES_VERSION=v1

# Qualitative macro/sector research via Gemini + Google Search grounding —
# reuses GOOGLE_AI_STUDIO_API_KEY above, no separate key needed.
RESEARCH_PROVIDER=gemini_search
RESEARCH_MAX_GROUNDED_ITEMS=8
ACTIVE_RESEARCH_PROMPT_VERSION=v1

MACRO_REFRESH_INTERVAL_HOURS=24
SECTOR_RESEARCH_REFRESH_INTERVAL_DAYS=7
ENABLE_SCHEDULER=true

DEFAULT_REPORTING_CURRENCY=NOK

# Optional overrides — app/config/settings.py's own defaults (kept in sync
# here) are what actually apply if these are left unset. v3 adds the
# prompt-injection guardrail in prompts/persona/v3.md — see
# docs/decisions/0015-agentic-coding-and-ai-safety-guardrails.md.
ACTIVE_PROMPT_VERSION=v3
ACTIVE_SCORING_VERSION=v2
ACTIVE_EXTRACTION_SCHEMA_VERSION=v1
ACTIVE_MACRO_REGIME_PROFILE=baseline
