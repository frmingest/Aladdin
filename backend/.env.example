# Copy this file to .env and fill in real values. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker Postgres (see docker/docker-compose.yml):
DATABASE_URL=postgresql://aladdin:aladdin@localhost:5432/aladdin
# Or point at Supabase instead. Project Settings > Database > Connection
# string in the Supabase dashboard offers three variants:
#   - Direct connection (db.<project-ref>.supabase.co:5432) — IPv6-only on
#     most projects unless you've bought the IPv4 add-on. If your network
#     doesn't have IPv6, this fails DNS resolution outright ("No such host
#     is known"), not just connection.
#   - Session pooler (aws-0-<region>.pooler.supabase.com:5432, username
#     postgres.<project-ref>) — IPv4-compatible, behaves like a normal
#     Postgres session (works fine with Alembic). Use this one if the
#     direct connection doesn't resolve.
#   - Transaction pooler (same host, port 6543) — pgbouncer transaction
#     mode; avoid for migrations, it can break prepared statements.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# "local" (dev only) | "s3" / "r2" / "supabase" — all three are accepted
# and all build the same S3-compatible client (app/providers/factory.py);
# set this to whichever backend you're actually pointing at.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=aladdin-documents
OBJECT_STORAGE_LOCAL_PATH=./storage
# The four settings below are only read when OBJECT_STORAGE_PROVIDER is
# "s3", "r2", or "supabase" — both real backends expose an S3-compatible
# API, so the same four settings configure either:
#   R2:       OBJECT_STORAGE_PROVIDER=r2
#             OBJECT_STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#             OBJECT_STORAGE_REGION=auto
#   Supabase: OBJECT_STORAGE_PROVIDER=supabase
#             OBJECT_STORAGE_ENDPOINT_URL=https://<project_ref>.supabase.co/storage/v1/s3
#             OBJECT_STORAGE_REGION=<project region, e.g. eu-west-1>
# Access key/secret: R2 = an API token's Access Key ID/Secret Access Key
# (Cloudflare dashboard > R2 > Manage API Tokens); Supabase = Storage's S3
# access keys (Project Settings > Storage > S3 Connection).
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

MAX_UPLOAD_SIZE_MB=25

# --- Live research (Sprint 2 — see claude/buffett-munger-rebuild-sprint-plan-2026-09-21.md
# and app/providers/gemini_research_provider.py) ---
# Qualitative macro/geopolitical, sector, and per-company research via
# Gemini + Google Search grounding — reuses GOOGLE_AI_STUDIO_API_KEY below,
# no separate key needed. "none" disables the feature outright.
RESEARCH_PROVIDER=gemini_search
ACTIVE_RESEARCH_PROMPT_VERSION=v1
RESEARCH_STALE_AFTER_HOURS=24

# Google AI Studio's free tier — get a key at https://aistudio.google.com/apikey.
# "google_ai_studio" | "mistral" | "ollama"
LLM_PROVIDER=google_ai_studio
GOOGLE_AI_STUDIO_API_KEY=
LLM_MODEL_NAME=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2

# Free-tier rate limits for LLM_MODEL_NAME. Hand-maintained — no API
# exposes a free-tier AI Studio key's quota. Defaults match
# gemini-3.6-flash's free tier as observed 2026-09-14/17.
LLM_RATE_LIMIT_RPM=5
LLM_RATE_LIMIT_TPM=250000
LLM_RATE_LIMIT_RPD=20

# --- Fallback LLM provider — used only once the primary's daily budget
# above is exhausted, so a holding gets a real analysis instead of being
# skipped outright. "none" (default) keeps the original skip-on-exhaustion
# behavior; set to "mistral" and fill in MISTRAL_API_KEY below to enable
# it. Get a free key at https://console.mistral.ai/api-keys.
LLM_FALLBACK_PROVIDER=none
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-small-latest
# Assumed conservative default, not vendor-confirmed — check
# https://console.mistral.ai/ for your account's actual limit and adjust.
MISTRAL_RATE_LIMIT_RPM=30

# --- Local LLM via Ollama (docs/local-llm-ollama-setup.md) ---
# Set LLM_PROVIDER=ollama to run the heavy analysis passes on your own GPU.
# Research (macro/sector/company) keeps using Gemini + Google Search above.
# Optional: LLM_FALLBACK_PROVIDER=google_ai_studio uses Gemini only when
# Ollama is down (it then spends the 20/day Gemini budget).
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3:14b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_THINK=false
# Only if Ollama sits behind an authenticating proxy/tunnel:
OLLAMA_API_KEY=

# --- Local analysis worker (Sprint 5B — `python -m app.worker`, see
# docs/local-llm-ollama-setup.md "Run analyses queued from Railway") ---
# Only read on the PC that runs the worker. It uses the same DATABASE_URL
# as Railway, claims runs queued with "Run on my PC", and runs research +
# both passes here on WORKER_LLM_PROVIDER (default ollama).
# WORKER_ID=my-desktop            # default: the computer's hostname
# WORKER_LLM_PROVIDER=ollama
# WORKER_POLL_SECONDS=30
# WORKER_LEASE_MINUTES=30         # a run is released if its worker is silent this long
# WORKER_MAX_ATTEMPTS=2

# --- Valuation engine (Sprint 3 — see
# claude/buffett-munger-rebuild-sprint-plan-2026-09-21.md and
# app/providers/yfinance_provider.py, app/providers/fred_risk_free_rate_provider.py) ---
# Live share price/FX/beta: yfinance needs no API key (Yahoo Finance,
# unofficial). "yfinance" is currently the only implemented option.
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_STALE_AFTER_HOURS=24
# DCF discount-rate's risk-free-rate term: FRED (10-year government bond
# yield, per currency — app/domain/risk_free_rate_series.py). Get a free
# key at https://fred.stlouisfed.org/docs/api/api_key.html. Valuation
# requests fail with an explicit error until this is set.
RISK_FREE_RATE_PROVIDER=fred
FRED_API_KEY=
ACTIVE_RISK_FREE_RATE_SERIES_VERSION=v1

# --- Primary-source filings (2026-09-22 — app/providers/sec_edgar_provider.py,
# app/providers/newsweb_provider.py). Both free and keyless. ---
# SEC EDGAR XBRL company facts -> FinancialLineItems for SEC-registered
# companies. The SEC requires a descriptive User-Agent with a contact email;
# imports fail with an explicit message until it is set.
FUNDAMENTALS_PROVIDER=sec_edgar
SEC_EDGAR_USER_AGENT=
SEC_EDGAR_MAX_YEARS=10
# Oslo Børs Newsweb regulated announcements for .OL / NOK holdings.
ANNOUNCEMENTS_PROVIDER=newsweb
ANNOUNCEMENTS_LOOKBACK_DAYS=365
ANNOUNCEMENTS_IN_EVIDENCE_PACKET=15

# Numeric macro data (2026-09-24, app/services/macro/): Norges Bank policy
# rate, NOWA, 3m bill, 10y yield, USD/NOK, EUR/NOK; SSB CPI; FRED fed funds,
# 10y, 10y-2y, CPI, unemployment, HY spread. Norges Bank and SSB need no key;
# FRED reuses FRED_API_KEY above. "none" = don't fetch (stored values shown).
MACRO_DATA_PROVIDER=live
ACTIVE_MACRO_SERIES_VERSION=v1
# Refresh a series before an analysis when its last fetch is older than this.
MACRO_STALE_AFTER_HOURS=20
# Background refresh loop in the API server (Railway); 0 = off.
MACRO_REFRESH_INTERVAL_HOURS=12
MACRO_HISTORY_YEARS=3
RISK_FREE_RATE_STALE_AFTER_HOURS=24
# Equity risk premium, terminal growth rate, and bull/bear scenario growth
# offsets — versioned assumptions (app/domain/valuation_assumptions/),
# never live-fetched. See that module's docstring for what v1 assumes and
# why; bump this (and add a v2 module) rather than hand-editing v1 once
# it's backed a real analysis run (CLAUDE.md Rule 3).
ACTIVE_VALUATION_ASSUMPTIONS_VERSION=v1
