        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "score": {
          "description": "1 = very poor, 10 = excellent",
          "maximum": 10,
          "minimum": 1,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "score",
        "confidence",
        "reasoning"
      ],
